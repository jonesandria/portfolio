---
import { photos, photoFilters } from '../data/photography';
import { ui, enData } from '../data/i18n';

const first = photos[0];
const photosZip = photos.map((p, i) => ({ ...p, en: enData.photography[i] }));
---

<section id="photography" class="border-t border-line px-5 py-16 sm:px-8 lg:px-14" data-reveal>
  <p class="mb-7 font-playfair text-sm italic text-gold-text" data-en={ui.eyebrow.photography}>— Photographie —</p>

  <div class="mb-8 flex flex-wrap items-center gap-8">
    <!-- Featured : une seule image propre, liée à activeIndex -->
    <div class="feat-frame relative h-[300px] min-w-[260px] flex-[1.2_1_380px] overflow-hidden rounded-[20px] border border-line sm:h-[320px] lg:h-[340px]">
      <img
        src={first.src}
        alt={first.title}
        data-featured
        class="h-full w-full object-cover object-center transition-opacity duration-300 ease-in-out motion-reduce:transition-none"
      />
    </div>
    <div class="flex flex-[1_1_260px] flex-col gap-3.5">
      <p class="font-playfair text-[19px] italic leading-[1.55] text-ink" data-en={ui.photography.quote}>
        « La photographie permet de capturer des émotions, des moments et des histoires. »
      </p>
      <p class="font-inter text-[12.5px] text-muted">Canon EOS Rebel T3 · 18–55mm · 80–200mm</p>
    </div>
  </div>

  <div class="mb-3 flex flex-wrap gap-2.5" data-filters>
    {
      photoFilters.map((label, i) => (
        <button
          type="button"
          data-filter={label}
          data-en={enData.photoFilters[label] ?? label}
          class:list={[
            'border-b-2 pb-1.5 font-sora text-[11.5px] transition-colors',
            i === 0 ? 'border-gold text-gold-text' : 'border-transparent text-muted hover:text-ink',
          ]}
        >
          {label}
        </button>
      ))
    }
  </div>

  <!-- Carousel 3D — activeIndex uniquement, compact, cartes jamais coupées -->
  <div class="relative mx-auto max-w-[1000px] select-none pb-6 pt-2 [perspective:1300px]" data-carousel tabindex="0" role="group" aria-roledescription="carousel" aria-label="Galerie photo">
    <div class="relative mx-auto h-[clamp(260px,40vh,380px)] [transform-style:preserve-3d]" data-stage>
      {
        photosZip.map((photo) => (
          <figure data-card data-category={photo.category} data-src={photo.src} class="absolute left-1/2 top-1/2 m-0 h-full w-[clamp(210px,64vw,300px)] overflow-hidden rounded-[18px] border border-line bg-surface-soft opacity-0 shadow-xl transition-[transform,opacity,filter] duration-500 ease-out will-change-transform motion-reduce:transition-none">
            <img src={photo.src} alt={photo.title} loading="lazy" class="pointer-events-none h-full w-full object-cover object-center" />
            <span class="absolute left-3 top-3 rounded-full border border-white/15 bg-black/45 px-2.5 py-1 font-sora text-[10px] uppercase tracking-[0.06em] text-white backdrop-blur-sm" data-en={photo.en.category}>{photo.category}</span>
            <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent p-4 opacity-0 transition-opacity duration-500 data-[active]:opacity-100">
              <div class="font-sora text-[16px] font-semibold text-white" data-en={photo.en.title}>{photo.title}</div>
              <p class="mt-1 font-inter text-[12.5px] leading-[1.5] text-white/85" data-en={photo.en.description}>{photo.description}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <button type="button" data-prev aria-label="Photo précédente" class="absolute left-0 top-1/2 z-40 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-bg/85 text-lg text-ink backdrop-blur transition-colors hover:border-gold sm:left-2">&lsaquo;</button>
    <button type="button" data-next aria-label="Photo suivante" class="absolute right-0 top-1/2 z-40 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-bg/85 text-lg text-ink backdrop-blur transition-colors hover:border-gold sm:right-2">&rsaquo;</button>
  </div>

  <p class="mt-2 text-center font-inter text-[11px] text-muted" data-en={ui.photography.hint}>Utilisez les flèches, le clavier ou glissez pour parcourir la galerie.</p>
</section>

<style>
  .feat-frame {
    background: var(--surface-soft);
    box-shadow: 0 18px 44px -24px rgba(0, 0, 0, 0.5);
  }
  :global([data-theme='light']) .feat-frame {
    box-shadow: 0 16px 36px -26px rgba(0, 0, 0, 0.28);
  }
</style>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var mobile = window.matchMedia('(max-width: 640px)');
    var carousel = document.querySelector('[data-carousel]');
    var stage = document.querySelector('[data-stage]');
    var featured = document.querySelector('[data-featured]');
    var filterBar = document.querySelector('[data-filters]');
    if (!carousel || !stage) return;
    var allCards = Array.prototype.slice.call(stage.querySelectorAll('[data-card]'));
    var visible = allCards.slice();
    var active = 0;

    function layout() {
      var isMobile = mobile.matches;
      var step = isMobile ? 50 : 56, depth = isMobile ? 55 : 110, rot = isMobile ? 9 : 18;
      visible.forEach(function (card, i) {
        var offset = i - active, abs = Math.abs(offset);
        var caption = card.querySelector('figcaption');
        if (abs > 2) {
          card.style.opacity = '0'; card.style.pointerEvents = 'none';
          card.style.transform = 'translate(-50%,-50%) translateX(' + (offset < 0 ? -200 : 200) + '%) scale(0.6)';
          card.removeAttribute('data-active'); caption.removeAttribute('data-active');
          return;
        }
        card.style.pointerEvents = 'auto';
        card.style.zIndex = String(50 - abs);
        card.style.transform = 'translate(-50%,-50%) translateX(' + offset * step + '%) translateZ(' + -abs * depth + 'px) rotateY(' + offset * -rot + 'deg) scale(' + (1 - abs * 0.12) + ')';
        card.style.opacity = abs === 0 ? '1' : abs === 1 ? '0.9' : '0.78';
        card.style.filter = abs === 0 ? 'none' : 'brightness(' + (1 - abs * 0.26) + ')';
        if (offset === 0) { card.setAttribute('data-active', ''); caption.setAttribute('data-active', ''); }
        else { card.removeAttribute('data-active'); caption.removeAttribute('data-active'); }
      });
      var current = visible[active];
      if (featured && current) {
        var src = current.getAttribute('data-src');
        if (featured.getAttribute('src') !== src) {
          featured.style.opacity = '0';
          setTimeout(function () {
            featured.src = src;
            featured.alt = current.querySelector('img').alt;
            featured.style.opacity = '1';
          }, reduce ? 0 : 180);
        }
      }
    }
    function setActive(i) { var n = visible.length; active = ((i % n) + n) % n; layout(); }
    var timer = null;
    function nextDelay() { return 6000 + Math.random() * 2000; }
    function play() { if (reduce) return; stop(); timer = setTimeout(function () { setActive(active + 1); play(); }, nextDelay()); }
    function stop() { clearTimeout(timer); }
    function pauseThenResume() { stop(); if (reduce) return; timer = setTimeout(function () { setActive(active + 1); play(); }, 8000); }
    var prev = carousel.querySelector('[data-prev]'), next = carousel.querySelector('[data-next]');
    if (prev) prev.addEventListener('click', function () { setActive(active - 1); pauseThenResume(); });
    if (next) next.addEventListener('click', function () { setActive(active + 1); pauseThenResume(); });
    carousel.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { setActive(active - 1); pauseThenResume(); }
      else if (e.key === 'ArrowRight') { setActive(active + 1); pauseThenResume(); }
    });
    allCards.forEach(function (card) {
      card.addEventListener('click', function () { var i = visible.indexOf(card); if (i >= 0 && i !== active) { setActive(i); pauseThenResume(); } });
    });
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', play);
    var startX = null;
    carousel.addEventListener('pointerdown', function (e) { startX = e.clientX; stop(); });
    carousel.addEventListener('pointerup', function (e) {
      if (startX === null) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > 40) { setActive(active + (dx < 0 ? 1 : -1)); }
      startX = null; pauseThenResume();
    });
    carousel.addEventListener('pointercancel', function () { startX = null; play(); });
    if (filterBar) {
      var buttons = filterBar.querySelectorAll('[data-filter]');
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var value = btn.getAttribute('data-filter');
          buttons.forEach(function (b) {
            var on = b === btn;
            b.classList.toggle('border-gold', on); b.classList.toggle('text-gold-text', on);
            b.classList.toggle('border-transparent', !on); b.classList.toggle('text-muted', !on);
          });
          visible = allCards.filter(function (card) { return value === 'Tous' || card.getAttribute('data-category') === value; });
          allCards.forEach(function (card) { card.style.display = visible.indexOf(card) >= 0 ? '' : 'none'; });
          setActive(0); pauseThenResume();
        });
      });
    }
    window.addEventListener('resize', layout);
    setActive(0); play();
  })();
</script>
