---
import { profile } from '../data/profile';
import { socialByKey } from '../data/socials';
import { ui, enData } from '../data/i18n';

const github = socialByKey['github'];

const NB = String.fromCharCode(160);
function splitRole(role: string) {
  const parts = role.split(/\s*[•·]\s*/).filter(Boolean);
  return { one: parts[0], two: parts.slice(1).join(NB + '•' + NB) };
}
const fr = splitRole(profile.role);
const en = splitRole(enData.profile.role);
---

<section
  id="hero"
  class="flex flex-wrap items-center gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:gap-16 lg:px-14 lg:py-[110px] lg:pb-16"
>
  <div class="flex min-w-[280px] flex-1 basis-[460px] flex-col justify-center gap-5" data-reveal>
    <p class="font-sora text-[11px] uppercase tracking-[0.14em] text-gold-text">
      {profile.eyebrow}
    </p>
    <h1 class="m-0 font-sora text-[clamp(34px,5vw,54px)] font-extrabold leading-[1.08] text-ink">
      {profile.lastName}<br />{profile.firstName}
    </h1>
    <p class="font-sora text-[18px] font-semibold leading-snug tracking-tight text-gold-text sm:text-[20px]">
      <span class="block" data-en={en.one}>{fr.one}</span>
      <span class="block" data-en={en.two}>{fr.two}</span>
    </p>
    <p class="m-0 max-w-[440px] font-inter text-[15px] leading-[1.65] text-muted" data-en={ui.hero.tagline}>
      {profile.tagline}
    </p>
    <div class="mt-1.5 flex flex-wrap gap-3.5">
      <a
        href="#projects"
        data-en={ui.hero.btnProjects}
        class="rounded-full bg-gold px-6 py-3 font-sora text-[13px] font-semibold text-navy transition-transform hover:-translate-y-0.5"
      >
        Voir mes projets
      </a>
      <a
        href={github.href}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-line px-6 py-3 font-sora text-[13px] font-semibold text-ink transition-colors hover:border-gold"
      >
        GitHub
      </a>
      <a
        href="#contact"
        data-en={ui.hero.btnContact}
        class="rounded-full border border-line px-6 py-3 font-sora text-[13px] font-semibold text-ink transition-colors hover:border-gold"
      >
        Me contacter
      </a>
    </div>
  </div>

  <figure
    class="hero-photo group relative m-0 min-w-[260px] flex-1 basis-[380px] self-center [max-width:560px]"
    data-reveal
  >
    <span class="hero-photo__glow pointer-events-none absolute -inset-4 -z-10 rounded-[32px]" aria-hidden="true"></span>
    <img
      src="/images/profile-jones.jpg"
      alt={`Portrait de ${profile.firstName} ${profile.lastName}`}
      class="hero-photo__img relative z-10 block h-[300px] w-full rounded-[28px] object-cover object-[center_42%] sm:h-[340px] lg:h-[360px]"
    />
    <span class="hero-photo__glass pointer-events-none absolute inset-0 z-20 rounded-[28px]" aria-hidden="true"></span>
  </figure>
</section>

<style>
  .hero-photo__img {
    outline: 1px solid rgba(214, 180, 106, 0.28);
    outline-offset: -1px;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.55);
    transition: transform 0.35s ease, box-shadow 0.35s ease, filter 0.35s ease;
  }
  .hero-photo__glass {
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }
  .hero-photo__glow {
    background: radial-gradient(60% 60% at 50% 40%, rgba(214, 180, 106, 0.35), transparent 70%);
    filter: blur(28px);
  }
  .hero-photo:hover .hero-photo__img {
    transform: translateY(-3px);
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.6);
    filter: brightness(1.04);
  }
  :global([data-theme='light']) .hero-photo__img {
    outline-color: rgba(143, 106, 46, 0.3);
    box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.28);
  }
  :global([data-theme='light']) .hero-photo__glow {
    background: radial-gradient(60% 60% at 50% 40%, rgba(214, 180, 106, 0.22), transparent 70%);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-photo__img {
      transition: none;
    }
    .hero-photo:hover .hero-photo__img {
      transform: none;
    }
  }
</style>
