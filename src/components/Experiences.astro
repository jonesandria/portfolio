---
import { experiences } from '../data/experiences';
import { ui, enData } from '../data/i18n';

const items = experiences.map((xp, i) => ({ ...xp, en: enData.experiences[i] }));
---

<section id="experiences" class="border-t border-line px-5 py-16 sm:px-8 lg:px-14" data-reveal>
  <p class="mb-8 font-playfair text-sm italic text-gold-text" data-en={ui.eyebrow.experience}>— Expériences —</p>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((xp) => (
        <article class="xp-card group flex h-full flex-col gap-3 rounded-[18px] border border-line bg-surface/50 p-6 backdrop-blur-sm">
          <div>
            <h3 class="font-sora text-[15.5px] font-semibold leading-snug text-ink" data-en={xp.en.role}>{xp.role}</h3>
            <p class="mt-1 font-sora text-[12.5px] font-medium text-gold-text">{xp.org}</p>
          </div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-inter text-[11px] text-muted">
            <span class="inline-flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <rect x="2.5" y="3.5" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.3" />
                <path d="M2.5 7h13M6 2v3M12 2v3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
              </svg>
              <span data-en={xp.en.period}>{xp.period}</span>
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M9 16s6-4.5 6-9A6 6 0 0 0 3 7c0 4.5 6 9 6 9z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                <circle cx="9" cy="7" r="2.2" stroke="currentColor" stroke-width="1.3" />
              </svg>
              <span data-en={xp.en.location}>{xp.location}</span>
            </span>
          </div>
          <p class="font-inter text-[12.5px] leading-[1.55] text-muted" data-en={xp.en.desc}>{xp.desc}</p>
          <div class="mt-auto flex flex-wrap gap-1.5 pt-1">
            {xp.tags.map((tag, j) => (
              <span class="rounded-full border border-line px-2.5 py-1 font-inter text-[10.5px] text-muted" data-en={xp.en.tags[j]}>
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .xp-card { transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease; }
  .xp-card:hover {
    transform: translateY(-3px);
    border-color: rgba(214, 180, 106, 0.45);
    box-shadow: 0 16px 40px -24px rgba(0, 0, 0, 0.6);
  }
  :global([data-theme='light']) .xp-card:hover { box-shadow: 0 14px 32px -24px rgba(0, 0, 0, 0.35); }
  @media (prefers-reduced-motion: reduce) {
    .xp-card { transition: none; }
    .xp-card:hover { transform: none; }
  }
</style>
