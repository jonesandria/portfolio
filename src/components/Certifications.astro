---
import { certifications } from '../data/certifications';
---

<section id="certifications" class="border-t border-line px-5 py-16 sm:px-8 lg:px-14" data-reveal>
  <p class="mb-8 font-playfair text-sm italic text-gold-text">— Formation &amp; Certifications —</p>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
    {
      certifications.map((cert) => (
        <article class="rounded-[14px] border border-line bg-surface p-5">
          <h3 class="mb-2 font-sora text-[13.5px] font-semibold leading-[1.35] text-ink">{cert.title}</h3>
          <p class="font-inter text-[11.5px] text-muted">
            {cert.org} · {cert.date}
          </p>
        </article>
      ))
    }
  </div>
</section>
