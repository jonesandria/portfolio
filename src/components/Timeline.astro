---
import { timeline } from '../data/timeline';
---

<section id="timeline" class="border-t border-line px-5 py-16 sm:px-8 lg:px-14" data-reveal>
  <p class="mb-10 font-playfair text-sm italic text-gold-text">— Parcours —</p>
  <div class="relative flex max-w-[720px] flex-col gap-[30px] pl-[26px]">
    <span class="absolute bottom-1 left-1 top-1 w-px bg-line"></span>
    {
      timeline.map((step) => (
        <div class="relative">
          <span class="absolute -left-[26px] top-[5px] h-[9px] w-[9px] rounded-full bg-gold"></span>
          <div class="mb-1.5 font-playfair text-[19px] text-gold-text">{step.year}</div>
          <div class="mb-1.5 font-sora text-[15px] font-semibold text-ink">{step.title}</div>
          <div class="font-inter text-[13px] leading-[1.55] text-muted">{step.desc}</div>
        </div>
      ))
    }
  </div>
</section>
