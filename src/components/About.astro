---
import { profile } from '../data/profile';

// Icônes SVG par pilier (santé, technologie, photographie, international).
const icons: Record<string, string> = {
  Santé:
    '<circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.3"/><path d="M9 5v8M5 9h8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>',
  Technologie:
    '<path d="M6 4L1 9l5 5M12 4l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>',
  Photographie:
    '<rect x="1" y="1" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.3"/><circle cx="9" cy="9" r="3.2" stroke="currentColor" stroke-width="1.3"/>',
  International:
    '<circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.3"/><path d="M2 9h14M9 2c2 2 3 4.5 3 7s-1 5-3 7c-2-2-3-4.5-3-7s1-5 3-7z" stroke="currentColor" stroke-width="1.1"/>',
};

const accentClass: Record<string, string> = {
  teal: 'text-teal-text',
  blue: 'text-blue-text',
  gold: 'text-gold-text',
};
---

<section id="about" class="max-w-[920px] border-t border-line px-5 py-16 sm:px-8 lg:px-14" data-reveal>
  <p class="mb-5 font-playfair text-sm italic text-gold-text">— À propos —</p>
  <p class="m-0 mb-9 font-playfair text-[clamp(20px,2.4vw,27px)] font-medium leading-[1.5] text-ink">
    {profile.aboutLead}
  </p>
  <div class="flex flex-wrap gap-9">
    {
      profile.aboutPillars.map((pillar) => (
        <div class={`flex items-center gap-2.5 ${accentClass[pillar.accent]}`}>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" set:html={icons[pillar.label]} />
          <span class="font-inter text-[13px] text-ink">{pillar.label}</span>
        </div>
      ))
    }
  </div>
</section>
